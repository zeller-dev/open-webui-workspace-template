# Ports
OLLAMA_PORT=11434
WEBUI_PORT=3000

# Default model to keep loaded (used by scripts, not compose itself)
DEFAULT_MODEL=qwen3:14b

# Open WebUI auth (set to false to require login screen)
WEBUI_AUTH=true

# Pin session signing key so logins survive container restarts/rebuilds.
# Generate your own with: openssl rand -hex 32
WEBUI_SECRET_KEY=changeme_generate_your_own_with_openssl_rand_hex_32

# CORS: * is fine for localhost-only use. Set to your actual origin
# (e.g. http://192.168.1.50:3000) if you expose this beyond your machine.
CORS_ALLOW_ORIGIN=*

# Timezone for container logs/timestamps
TZ=UTC
