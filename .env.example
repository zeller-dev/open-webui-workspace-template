# ==========================================
# OPEN WEBUI ENVIRONMENT CONFIGURATION
# Copy this file to '.env' or run 'npm run setup' to initialize automatically.
# ==========================================

# ==========================================
# 1. CORE SERVER & AUTHENTICATION
# ==========================================
# Generated automatically during 'npm run setup' (or print manually via 'npm run generate-key')
WEBUI_SECRET_KEY=your_generated_32_byte_hex_secret_here
WEBUI_NAME="AI Workspace"

# Canonical URL used for browser redirects and OAuth/SSO (matches host port in docker-compose.yml)
WEBUI_URL=http://localhost:3333

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOW_ORIGIN=http://localhost:3333

# Language & System Defaults
DEFAULT_LOCALE=en
DEFAULT_SYSTEM_PROMPT="You are a helpful, direct assistant. Provide straightforward answers without unnecessary code blocks or over-complications."

# Authentication Mode:
# Set to 'False' for local single-user mode (bypasses login entirely on fresh install)
# Set to 'True' to require account sign-in
WEBUI_AUTH=False

# Force container to prioritize this file over cached SQLite configurations
ENABLE_PERSISTENT_CONFIG=False

# Registration Settings (Active when WEBUI_AUTH=True)
ENABLE_SIGNUP=True
DEFAULT_USER_ROLE=pending

# ==========================================
# 2. LOCAL & EXTERNAL MODEL PROVIDERS
# ==========================================
# Ollama Endpoint:
# - Use 'http://ollama:11434' if running Ollama inside docker compose
# - Use 'http://host.docker.internal:11434' if running Ollama natively on host
OLLAMA_BASE_URL=http://ollama:11434
ENABLE_OLLAMA_API=True

# Default model loaded in new chat sessions (points to custom Modelfile built by setup.js)
DEFAULT_MODELS=workspace-assistant

# Optional: External Provider API Keys
OPENAI_API_KEY=

# ==========================================
# 3. ENHANCED RAG (DOCUMENT RETRIEVAL)
# ==========================================
# Combines dense vector search with BM25 keyword matching
ENABLE_RAG_HYBRID_SEARCH=True
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text

# Document Chunking Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RAG_TOP_K=5

# Vector Database Engine ('chroma', 'pgvector', 'qdrant', etc.)
VECTOR_DB=chroma

# ==========================================
# 4. PRIVACY & ACCESS CONTROL
# ==========================================
ENABLE_COMMUNITY_SHARING=False
ENABLE_MODEL_FILTER=False
SHOW_ADMIN_DETAILS=False

# ==========================================
# 5. PERFORMANCE & CONCURRENCY
# ==========================================
# Number of ASGI worker processes (4 is optimal for local workstation setups)
WEBUI_CONCURRENCY=4

# Offline Mode (0 = allow fetching online embeddings/models; 1 = strictly offline)
HF_HUB_OFFLINE=0