{
  "name": "local-llm-stack",
  "version": "1.0.0",
  "private": true,
  "description": "Ollama + Open WebUI, containerized",
  "scripts": {
    "setup": "node scripts/setup.js",
    "up": "npm run setup && docker compose up -d",
    "down": "docker compose down",
    "reset": "docker compose down -v",
    "logs": "docker compose logs -f",
    "list": "docker exec -it ollama ollama list",
    "pull": "docker exec -it ollama ollama pull",
    "pull-embed": "docker exec -it ollama ollama pull nomic-embed-text"
  }
}