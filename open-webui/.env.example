WEBUI_PORT=3000
WEBUI_AUTH=true

# Pin session signing key so logins survive container restarts/rebuilds.
# Auto-generated by `npm run setup` — don't set manually.
WEBUI_SECRET_KEY=changeme_generate_your_own_with_openssl_rand_hex_32

# CORS: * is fine for localhost-only use. Set to your actual origin
# (e.g. http://192.168.1.50:3000) if you expose this beyond your machine.
CORS_ALLOW_ORIGIN=*

# Tiny model for background tasks (title/tag generation) — keep this small,
# don't point it at your main chat model or every message triggers extra
# full inferences just to name the chat.
TASK_MODEL=llama3.2:1b
ENABLE_AUTOCOMPLETE_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false

# Route RAG embeddings through the local Ollama instance instead of Open
# WebUI's default (downloads sentence-transformers/all-MiniLM-L6-v2 from
# Hugging Face on first boot). Model must already be imported into Ollama —
# see ollama/README.md.
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=embeddinggemma-300m-q8-0

TZ=UTC